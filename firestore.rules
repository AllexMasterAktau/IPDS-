rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isNonEmptyString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidSharedAnalysis() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id',
          'authorEmail',
          'projectName',
          'region',
          'hasAnalysis',
          'docsCount',
          'createdAt',
          'updatedAt'
        ])
        // Запрещаем сохранение исходных файлов пользователя в общую БД
        && !('documents' in data)
        && data.id == projectId
        && isNonEmptyString(data.id, 3, 120)
        && isNonEmptyString(data.authorEmail, 3, 160)
        && data.authorEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && isNonEmptyString(data.projectName, 1, 240)
        && isNonEmptyString(data.region, 1, 120)
        && data.hasAnalysis is bool
        && data.docsCount is int
        && data.docsCount >= 0
        && data.docsCount <= 1000
        && isNonEmptyString(data.createdAt, 8, 64)
        && isNonEmptyString(data.updatedAt, 8, 64);
    }

    // Облегчённые паспорта и готовые анализы проектов (без исходных файлов)
    match /ipds_shared_analyses/{projectId} {
      allow read: if true;
      allow create, update: if isValidSharedAnalysis();
      allow delete: if true;
    }

    // Хэш ключа создателя площадки (SHA-256, без открытого пароля)
    match /ipds_settings/creator {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'adminEmail',
          'adminKeyHash',
          'updatedAt'
        ])
        && isNonEmptyString(request.resource.data.adminEmail, 3, 160)
        && isNonEmptyString(request.resource.data.adminKeyHash, 16, 128)
        && isNonEmptyString(request.resource.data.updatedAt, 8, 64);
      allow update, delete: if false;
    }

    // Проверка соединения при старте терминала
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Блокируем доступ ко всем остальным коллекциям
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
